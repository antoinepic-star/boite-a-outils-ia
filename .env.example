# Copie ce fichier en ".env" en local et remplis les valeurs (ne jamais committer le ".env" lui-même)
# Sur Render, renseigne ces mêmes variables dans le dashboard (Environment), pas dans ce fichier.

# Connexion : identité centralisée, vérifiée auprès d'Administration.
# ADMINISTRATION_URL = URL de l'app Administration déployée.
# INTERNAL_API_SECRET = doit être IDENTIQUE à la valeur INTERNAL_API_SECRET d'Administration.
ADMINISTRATION_URL=
INTERNAL_API_SECRET=

JWT_SECRET=

PORT=3070

# Signatures de la charte. Vide en local -> fichier SQLite data/boite-a-outils.db.
# En prod sur Render, renseigne une base Turso dédiée (sinon les signatures sont perdues à chaque redéploiement).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
